                 fwmark=None):
        self.kind = kind            # "ip" | "range" | "fwmark"
        self.low = low              # int (first address) or None
        self.high = high            # int (last address) or None
        self.port = port
        self.raw = raw              # member text as written
        self.where = where
        self.gate = gate
