class Model:
    """Everything the parser extracted, plus the loader's
    findings and the blockers that can poison a verdict."""
    def __init__(self, loader, config_id):
        self.loader = loader
        self.config_id = config_id
        self.findings = list(loader.findings)
        self.instances = []
        self.virtual_servers = []
        self.groups = []
        self.sync_groups = []
        self.scripts = []           # ScriptDef objects
        self.static_entries = []
        self.script_inventory = []  # {"class","path","where"}
        self.seq_lines = []         # {"where","gate","text"}
        self.random_lines = []      # {"where","gate","text"}
        self.gated_lines = []       # {"where","gate"}
        self.unfollowed = list(loader.unfollowed)
        self.unparseable = []       # {"where","scope","message"}
        self.gated_candidates = []  # {"kind","where","message"}
        self.blockers = []          # {"kind","where","message"}
        self.skipped_lines = 0
        self.static_routes = 0
        self.static_rules = 0
        self.virtual_routes = 0
        self.virtual_rules = 0
        self.instances_by_name = {}
        self.groups_by_name = {}
        self.scripts_by_name = {}
        self.vip_by_address = {}
        self.duplicate_instances = {}
        self.duplicate_groups = {}
        self.duplicate_vs = {}
        self.vrid_collisions = []

    # -- blocker helpers ---------------------------------------------

    def add_blocker(self, kind, where, message):
        self.blockers.append({"kind": kind, "where": where,
                              "message": message})

    def add_gated_candidate(self, kind, where, message, name=None):
        self.gated_candidates.append({"kind": kind, "where": where,
                                      "message": message,
                                      "name": name})

    def add_unparseable(self, where, scope, message):
        self.unparseable.append({"where": where, "scope": scope,
                                 "message": message})
        self.findings.append(Finding(
            "KV21", "finding",
            "unparseable line: %s" % message, where))

    def global_blockers(self):
        """Blockers that can poison any declaration query: an
        unfollowed include (KV04) or a ${_RANDOM} declaration
        line (KV06). ~SEQ/~LST lines are scoped separately
        (seq_blockers_for), because what they could generate
        depends on the remainder of the line (KV07)."""
        out = []
        for u in self.unfollowed:
            out.append({"kind": "unfollowed-include",
                        "where": u["where"],
                        "message": u["reason"]})
        for b in self.blockers:
            out.append(b)
        return out

    def seq_blockers_for(self, kinds):
        """~SEQ/~LST lines that could generate an answer of one
        of the given kinds. A line whose kind is 'unknown' could
        generate anything, so it is included in every set."""
        out = []
        for s in self.seq_lines:
            if s.get("kind") in kinds or \
                    s.get("kind") == "unknown":
                out.append({
                    "kind": "seq", "where": s["where"],
                    "message": "~SEQ/~LST line could generate "
                               "the queried declaration "
                               "([seq-unknown], KV07)"})
        return out

    # -- finalize ------------------------------------------------------

    def finalize(self):
        for inst in self.instances:
            if inst.name is not None:
                self.instances_by_name.setdefault(
                    inst.name, []).append(inst)
        for grp in self.groups:
            if grp.name is not None:
                self.groups_by_name.setdefault(
                    grp.name, []).append(grp)
        for sc in self.scripts:
            if sc.name is not None:
                self.scripts_by_name.setdefault(
                    sc.name, []).append(sc)
        for inst in self.instances:
            for vip in inst.vips:
                self.vip_by_address.setdefault(
                    vip.address, []).append((inst, vip))
        self.duplicate_instances = {
            n: v for n, v in self.instances_by_name.items()
            if len(v) > 1}
        self.duplicate_groups = {
            n: v for n, v in self.groups_by_name.items()
            if len(v) > 1}
        vs_by_key = {}
        for vs in self.virtual_servers:
            if vs.form != "ip" or vs.address is None:
                continue
            key = (vs.address, vs.port,
                   vs.protocol or "TCP")
            vs_by_key.setdefault(key, []).append(vs)
        self.duplicate_vs = {k: v for k, v in vs_by_key.items()
                             if len(v) > 1}
        # Sync-group membership + dangling members (KV14).
        for sg in self.sync_groups:
            for name, where in sg.members:
                if name not in self.instances_by_name:
                    self.findings.append(Finding(
                        "KV14", "finding",
                        "vrrp_sync_group %s names instance %r "
                        "which is never defined (dangling "
                        "reference)" % (sg.name, name), where))
                else:
                    for inst in self.instances_by_name[name]:
                        if sg not in inst.sync_groups:
                            inst.sync_groups.append(sg)
        # Dangling vrrp_script references (KV15).
        for inst in self.instances:
            for kind, name, _w, where in inst.track:
                if kind == "track_script" and \
                        name not in self.scripts_by_name:
                    self.findings.append(Finding(
                        "KV15", "finding",
                        "track_script %r in instance %s is never "
                        "defined as a vrrp_script (dangling "
                        "reference)" % (name, inst.name), where))
        for sg in self.sync_groups:
            for kind, name, _w, where in sg.track:
                if kind == "track_script" and \
                        name not in self.scripts_by_name:
                    self.findings.append(Finding(
                        "KV15", "finding",
                        "track_script %r in sync group %s is "
                        "never defined as a vrrp_script (dangling "
                        "reference)" % (name, sg.name), where))
        # Same VRID + interface + address family (KV13): a
        # warning, not an AMBIGUOUS verdict.
        for i, a in enumerate(self.instances):
            for b in self.instances[i + 1:]:
                if a.interface is None or b.interface is None:
                    continue
                if a.interface != b.interface:
                    continue
                if a.vrid is None or b.vrid is None:
                    continue
                if a.vrid != b.vrid:
                    continue
                fa = {v.address.version for v in a.vips}
                fb = {v.address.version for v in b.vips}
                if fa and fb and not (fa & fb):
                    continue
                self.vrid_collisions.append((a, b))
                self.findings.append(Finding(
                    "KV13", "finding",
                    "instances %s (%s) and %s (%s) share VRID %d "
                    "on interface %s (the man page warns "
                    "duplicating a virtual_router_id on the same "
                    "interface has been known to cause problems "
                    "with some network switches)"
                    % (a.name, a.where, b.name, b.where, a.vrid,
                       a.interface), a.where))
        # Same-protocol virtual_servers sharing one group (KV12):
        # a finding, not AMBIGUOUS.
        for grp in self.groups:
            if grp.name is None:
                continue
            users = [vs for vs in self.virtual_servers
                     if vs.form == "group" and
                     vs.group_name == grp.name]
            if not users:
                self.findings.append(Finding(
                    "KV12", "finding",
                    "virtual_server_group %s is defined but no "
                    "virtual_server uses it" % grp.name, grp.where))
                continue
            by_proto = {}
            for vs in users:
                by_proto.setdefault(vs.protocol or "TCP",
                                    []).append(vs)
            for proto, vss in by_proto.items():
                if len(vss) > 1:
                    self.findings.append(Finding(
                        "KV12", "finding",
                        "%d %s virtual_servers use group %s (the "
                        "man page says do not configure more than "
                        "one TCP, one UDP and one SCTP virtual "
                        "server with the same address family using "
                        "the same virtual server group)"
                        % (len(vss), proto, grp.name),
                        vss[0].where))
        # Empty instances (KV23).
        for inst in self.instances:
            if not inst.vips:
                if inst.no_virtual_ipaddress:
                    self.findings.append(Finding(
                        "KV23", "finding",
                        "instance %s has no VIPs; "
                        "no_virtual_ipaddress is set (the daemon "
                        "suppresses its no-VIP warning for this "
                        "instance)" % inst.name, inst.where))
                else:
                    self.findings.append(Finding(
                        "KV23", "warning",
                        "instance %s has no VIPs and "
                        "no_virtual_ipaddress is not set (the "
                        "daemon warns about an instance with no "
                        "VIPs)" % inst.name, inst.where))

