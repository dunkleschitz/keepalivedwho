#!/usr/bin/env python3
"""keepalivedwho - which include file:line declared this
`vrrp_instance` / `virtual_server` / VIP, and is it gated by a
config-id conditional?

A static model of keepalived's documented configuration rules
(DESIGN-keepalivedwho.md, BUILD APPROVED 2026-11-09). Semantics
pinned to keepalived.conf(5) as published at keepalived.org
(current), keepalived.conf(5) Debian bullseye (older, plain
`include` only), keepalived(8) Arch 2025-03-29, and glob(3P)
POSIX. Claims are tagged [documented], [docs-inferred], or
[hypothesized]; no keepalived binary exists on this box, so no
claim here is [observed] and there is no live-agreement test to
skip-guard against: `keepalived -t` validates syntax but dumps
no per-declaration provenance, so hermetic fixture trees are the
only oracle, exactly as the manual text is the only authority.

Pinned semantics (KV01-KV24 in the design doc):
- KV01 verdict scope is declaration provenance, never election:
  mastership is never adjudicated ([mastership-not-adjudicated]
  on every instance answer).
- KV02 include chain: in-place expansion at the directive point,
  relative includes resolved against the including file's
  directory, glob matches in byte-wise sorted order, csh-style
  brace expansion implemented here (Python's glob does not
  expand braces), include cycles fatal (exit 2), --conf
  repeatable with concatenation bannered.
- KV03 include variants and the include_check level stack:
  plain `include` silently tolerates a missing file (warning);
  `includea`/active `include_check` makes the same miss a
  config error (fatal, exit 2). The level is positional and
  stack-scoped: saved on file entry, restored on exit.
- KV04 include detection runs before @-conditional and $
  substitution processing: an `@`-prefixed include line or an
  include pattern containing `$` is not followed (finding, and
  UNKNOWN if the unfollowed subtree could hold the answer).
- KV05 @config-id conditionals are three-valued: without
  --config-id a @-gated line is [gated-unknown], never silently
  included or dropped. The tool deliberately does NOT default
  to the local hostname (the daemon's default); --config-id is
  the reproducible form, and every run without it carries the
  [config-id-not-given] banner.
- KV06 $PARAM substitution is modeled positionally and
  recursively; ${_PWD}/${_INSTANCE}/${_HASH}/${_BANG} are
  pre-defined; ${_RANDOM} is [random-unknown]; an undefined
  $PARAM is left as-is.
- KV07 ~SEQ/~LST lines are unmodeled, never expanded:
  [seq-unknown], inventoried, UNKNOWN-poisoning.
- KV09 vrrp_instance context fields (state, interface, VRID,
  priority, advert_int, nopreempt, ...).
- KV10 VIP matching ignores the mask; virtual_ipaddress_excluded
  entries still count as VIPs ([excluded-from-adverts]).
- KV11 virtual_server: IP[:port] / fwmark / group forms; a
  port-less (persistent) VS matches a port-qualified query with
  a finding [docs-inferred].
- KV12 virtual_server_group ranges are tested by membership
  arithmetic, never enumeration.
- KV13 duplicates are flagged, never first-wins: duplicate
  instance names, same VIP on two instances, duplicate VS
  IP:port, duplicate group names are AMBIGUOUS.
- KV14 sync groups and tracking are context, never verdicts.
- KV15 scripts are inventoried, never executed.
- KV16 static_ipaddress entries are NOT VIPs: a query matching
  only one is NOT-A-VIP.
- KV17 three-valued gating propagation (Kleene core for
  declarations).
- KV18 exact verdict vocabulary: FOUND / GATED-UNKNOWN /
  NOT-FOUND / NOT-A-VIP / AMBIGUOUS / UNKNOWN.
- KV19 inventory modes --list-instances / --list-vips /
  --list-servers.
- KV20 coverage on every run.
- KV21 unparseable lines poison the selected answer only;
  unparseable lines outside the queried declaration are
  warnings. One broken instance must not blind the tool to the
  other forty.
- KV22 priority/state/preempt are context; the "why didn't it
  take it" shape ends with [mastership-not-adjudicated].
- KV23 empty instances are FOUND with zero VIPs.
- KV24 include variants are 2.2-era and later; auth_hmac keys
  are inventoried as present, never with values.

The tool never runs keepalived, never executes a script, never
opens a socket, never writes, and never reads the process
environment, and opens config and include files read-only.

Exit codes: 0 verdict FOUND rendered, or an inventory mode with
>=1 item; 1 GATED-UNKNOWN, NOT-FOUND, NOT-A-VIP, AMBIGUOUS,
UNKNOWN, or an inventory mode with nothing listed; 2 usage
error, missing config, include cycle (KV02), include_check
failure (KV03), or a malformed query.
"""

import argparse
import glob
import ipaddress
import json
import os
import re
import sys

VERSION = "1.0.0"

DEFAULT_CONF = "/etc/keepalived/keepalived.conf"
MAX_INCLUDE_DEPTH = 64
MAX_SUBST_PASSES = 16

# ---------------------------------------------------------------- findings

class Finding:
    """One structural finding. `fid` is a design-doc id (KV01..KV24)
    or "GEN" for a generic loader problem; `severity` is one of
    "finding", "warning", "info". `where` is "path:line" or None."""
    def __init__(self, fid, severity, message, where=None):
        self.fid = fid
        self.severity = severity
        self.message = message
        self.where = where

    def text(self):
        loc = " (%s)" % self.where if self.where else ""
        return "[%s] %s: %s%s" % (self.fid, self.severity, self.message, loc)

    def as_json(self):
        return {"id": self.fid, "severity": self.severity,
                "message": self.message, "where": self.where}


class FatalConfig(Exception):
    """A loader defect that ends the run (exit 2): unreadable or
    missing config, missing include under an active check level,
    include cycle, include depth exceeded."""
    def __init__(self, message, where=None):
        super().__init__(message)
        self.message = message
        self.where = where


class UsageError(Exception):
    """A CLI usage defect (exit 2)."""
    def __init__(self, message):
        super().__init__(message)
        self.message = message


class _ReadError(Exception):
    """Internal: a file could not be read. The caller decides
    whether that is fatal (top-level config, readable check) or
    a warning (plain include tolerates it, KV03)."""
    def __init__(self, message, where=None):
        super().__init__(message)
        self.message = message
        self.where = where


# ------------------------------------------------------------------- gates

# Gate states (KV05/KV17). Dropped lines never reach the model.
UNGATED = "ungated"
GATED_INCLUDED = "gated-included"
GATED_UNKNOWN = "gated-unknown"


def combine_gate(a, b):
    """Combine an enclosing gate with a line's own gate. A
    gated-unknown anywhere in the chain makes the declaration
    gated-unknown (KV17)."""
    if a == GATED_UNKNOWN or b == GATED_UNKNOWN:
        return GATED_UNKNOWN
    if a == GATED_INCLUDED or b == GATED_INCLUDED:
        return GATED_INCLUDED
    return UNGATED


# --------------------------------------------------------------- tokenizing

class Token:
    """One config token. `quoted` records whether any part of the
    token was written in quotes."""
    __slots__ = ("text", "quoted")

    def __init__(self, text, quoted=False):
        self.text = text
        self.quoted = quoted

    def __repr__(self):
        return "Token(%r, quoted=%r)" % (self.text, self.quoted)


_ESCAPES = {
    "a": "\x07", "b": "\x08", "E": "\x1b", "f": "\x0c",
    "n": "\n", "r": "\r", "t": "\t", "v": "\x0b",
}


def decode_escapes(text):
    """Decode keepalived.conf(5) quoted-string escapes: \\a \\b \\E
    \\f \\n \\r \\t \\v, \\nnn (octal), \\xXX (hex), \\cC (control).
    An unrecognized escape yields the escaped char literally
    [documented]."""
    out = []
    i = 0
    while i < len(text):
        ch = text[i]
        if ch != "\\" or i + 1 >= len(text):
            out.append(ch)
            i += 1
            continue
        nxt = text[i + 1]
        if nxt in _ESCAPES:
            out.append(_ESCAPES[nxt])
            i += 2
            continue
        if nxt == "x":
            hexpart = text[i + 2:i + 4]
            if len(hexpart) == 2 and all(
                    c in "0123456789ABCDEFabcdef" for c in hexpart):
                out.append(chr(int(hexpart, 16)))
                i += 4
                continue
            # Not a valid \xXX escape: keep the backslash and
            # reprocess the 'x' as an ordinary character.
            out.append("\\")
            i += 1
            continue
        if nxt == "c" and i + 2 < len(text):
            out.append(chr(ord(text[i + 2]) & 0x1f))
            i += 3
            continue
        if nxt in "01234567":
            j = i + 1
            digits = []
            while j < len(text) and len(digits) < 3 and \
                    text[j] in "01234567":
                digits.append(text[j])
                j += 1
            out.append(chr(int("".join(digits), 8)))
            i = j
            continue
        out.append(nxt)
        i += 2
    return "".join(out)


def strip_comment(line):
    """Cut a `#` or `!` comment: either character starts a comment
    to the end of the line anywhere outside quotes [documented].
    A backslash-escaped quote does not end a quoted section."""
    out = []
    quote = None
    i = 0
    while i < len(line):
        ch = line[i]
        if quote is not None:
            out.append(ch)
            if ch == "\\" and i + 1 < len(line):
                out.append(line[i + 1])
                i += 2
                continue
            if ch == quote:
                quote = None
            i += 1
            continue
        if ch in ("#", "!"):
            break
        if ch in ("'", '"'):
            quote = ch
        out.append(ch)
        i += 1
    return "".join(out)


def tokenize(line):
    """Split a (comment-stripped) config line into tokens. `{` and
    `}` are tokens of their own even when adjacent to other
    characters (KV08); double or single quotes group one token and
    their escapes are decoded (KV08); a `#`/`!` inside quotes is
    literal. A backslash outside quotes is kept literally; inside
    quotes it starts an escape (so `\"` does not close the quote).
    A token may mix quoted and unquoted spans; only the quoted
    spans are escape-decoded."""
    tokens = []
    cur = []
    quoted = False
    quote = None
    qbuf = []
    i = 0
    while i < len(line):
        ch = line[i]
        if quote is not None:
            if ch == "\\" and i + 1 < len(line):
                qbuf.append(ch)
                qbuf.append(line[i + 1])
                i += 2
                continue
            if ch == quote:
                cur.append(decode_escapes("".join(qbuf)))
                qbuf = []
                quote = None
                i += 1
                continue
            qbuf.append(ch)
            i += 1
            continue
        if ch in ("'", '"'):
            quote = ch
            quoted = True
            i += 1
            continue
        if ch in ("{", "}"):
            if cur or quoted:
                tokens.append(Token("".join(cur), quoted))
                cur = []
                quoted = False
            tokens.append(Token(ch))
            i += 1
            continue
        if ch.isspace():
            if cur or quoted:
                tokens.append(Token("".join(cur), quoted))
                cur = []
                quoted = False
            i += 1
            continue
        cur.append(ch)
        i += 1
    if qbuf:
        # Unterminated quote: decode what was gathered and keep it.
        cur.append(decode_escapes("".join(qbuf)))
    if cur or quoted:
        tokens.append(Token("".join(cur), quoted))
    return tokens


def logical_lines(path):
    """Yield (lineno, text) logical lines of a config file:
    physical lines joined on backslash-newline continuation. The
    line number reported is the first physical line of the logical
    line. Returns (lines, byte_count)."""
    with open(path, "r", encoding="utf-8", errors="replace") as fh:
        raw = fh.read()
    phys = raw.split("\n")
    if phys and phys[-1] == "":
        phys.pop()
    out = []
    i = 0
    while i < len(phys):
        lineno = i + 1
        text = phys[i]
        while text.endswith("\\") and i + 1 < len(phys):
            text = text[:-1] + phys[i + 1]
            i += 1
        out.append((lineno, text))
        i += 1
    return out, len(raw.encode("utf-8", errors="replace"))


# ----------------------------------------------------------- brace expansion

def _brace_split(inner):
    """Split the inside of one {...} group on top-level commas
    (nested braces do not split)."""
    parts = []
    depth = 0
    cur = []
    for ch in inner:
        if ch == "{":
            depth += 1
            cur.append(ch)
        elif ch == "}":
            depth -= 1
            cur.append(ch)
        elif ch == "," and depth == 0:
            parts.append("".join(cur))
            cur = []
        else:
            cur.append(ch)
    parts.append("".join(cur))
    return parts


def _find_brace_group(pattern):
    """Return (start, end, inner) of the first top-level {...}
    group in pattern, or None. Unbalanced braces yield None."""
    depth = 0
    start = None
    for i, ch in enumerate(pattern):
        if ch == "{":
            if depth == 0:
                start = i
            depth += 1
        elif ch == "}":
            depth -= 1
            if depth == 0 and start is not None:
                return start, i, pattern[start + 1:i]
            if depth < 0:
                return None
    return None


def expand_braces(pattern):
    """Csh-style brace expansion [documented -- keepalived.conf(5):
    include patterns may use brace expressions such as
    "{foo/{,cat,dog},bar}" if glob() supports them]. Python's glob
    does not expand braces, so this is the tool's own job (KV02):
    nested braces and empty alternatives are supported. An
    unbalanced brace group is left as-is (glob then treats it as
    a literal, matching nothing)."""
    group = _find_brace_group(pattern)
    if group is None:
        return [pattern]
    start, end, inner = group
    out = []
    for alt in _brace_split(inner):
        expanded = pattern[:start] + alt + pattern[end + 1:]
        out.extend(expand_braces(expanded))
    return out


def first_level_alternatives(pattern):
    """The patterns produced by expanding only the outermost brace
    group once (used for the brace_match check, KV03: each brace
    alternative must match a file)."""
    group = _find_brace_group(pattern)
    if group is None:
        return [pattern]
    start, end, inner = group
    return [pattern[:start] + alt + pattern[end + 1:]
            for alt in _brace_split(inner)]

# ------------------------------------------------------------------ loader

INCLUDE_VARIANTS = {
    "include": set(),
    "includer": {"readable"},
    "includem": {"match"},
    "includew": {"wildcard_match"},
    "includeb": {"brace_match"},
    "includea": {"readable", "match", "wildcard_match",
                 "brace_match"},
}
ALL_CHECKS = {"readable", "match", "wildcard_match", "brace_match"}


class MergedLine:
    """One logical line of the merged include stream, with
    provenance. `raw` keeps the original text (comments included);
    the parser strips comments per line so that ${_HASH}/${_BANG}
    substitution cannot create a comment (KV06)."""
    __slots__ = ("file", "lineno", "raw")

    def __init__(self, file, lineno, raw):
        self.file = file
        self.lineno = lineno
        self.raw = raw

    @property
    def where(self):
        return "%s:%d" % (self.file, self.lineno)


class Loader:
    """Loads config files into one merged logical-line stream,
    expanding includes in place (KV02) under the include_check
    level stack (KV03). Include detection runs on the raw line
    before @-conditional and $ substitution processing (KV04),
    so an @-prefixed include or a $-pattern include is never
    followed. include_check lines are consumed here, in stream
    order, because the level they set governs the includes that
    follow them in the same file."""

    def __init__(self, config_id):
        self.config_id = config_id
        self.lines = []            # [MergedLine] in load order
        self.files = []            # {"path","bytes","lines",
                                   #  "included_from"}
        self.expansions = []       # include directives, with
                                   # variant + effective level
        self.findings = []
        self.unfollowed = []       # {"where","pattern","reason"}
        self.check_level = set()   # current include_check level
        self._level_stack = []
        self._stack = []           # abspaths currently loading

    def load(self, paths):
        for path in paths:
            self._load_one(path, 0, None, top=True)
        return self.lines

    # -- level handling ------------------------------------------------

    def _apply_include_check(self, tokens, where):
        """Apply an `include_check [OPTIONS]` line to the current
        level (KV03). Bare options replace the level with exactly
        those options; `+opt` adds, `-opt` removes; no option at
        all means all options. Unknown options are findings."""
        opts = [t.text for t in tokens[1:]]
        if not opts:
            self.check_level = set(ALL_CHECKS)
            return
        bare = [o for o in opts if not o.startswith(("+", "-"))]
        if bare:
            new_level = set()
            for o in bare:
                if o not in ALL_CHECKS:
                    self.findings.append(Finding(
                        "KV03", "finding",
                        "unknown include_check option %r" % o,
                        where))
                else:
                    new_level.add(o)
            self.check_level = new_level
        for o in opts:
            if o.startswith("+"):
                name = o[1:]
                if name not in ALL_CHECKS:
                    self.findings.append(Finding(
                        "KV03", "finding",
                        "unknown include_check option %r" % o,
                        where))
                else:
                    self.check_level.add(name)
            elif o.startswith("-"):
                name = o[1:]
                if name not in ALL_CHECKS:
                    self.findings.append(Finding(
                        "KV03", "finding",
                        "unknown include_check option %r" % o,
                        where))
                else:
                    self.check_level.discard(name)

    def _gate_of_at_line(self, tokens):
        """Gate of a line whose first token is `@WORD` or `@^WORD`
        (KV05). Returns (gate, rest_tokens) or (None, None) when
        the @ is malformed. `gate` is one of UNGATED,
        GATED_INCLUDED, GATED_UNKNOWN, or "dropped"."""
        first = tokens[0].text
        if len(first) < 2 or first[1:2] == " ":
            return None, None
        neg = first.startswith("@^")
        word = first[2:] if neg else first[1:]
        if not word:
            return None, None
        if self.config_id is None:
            return GATED_UNKNOWN, tokens[1:]
        matched = (word == self.config_id)
        if neg:
            matched = not matched
        return (GATED_INCLUDED if matched else "dropped"), \
            tokens[1:]

    # -- file loading --------------------------------------------------

    def _load_one(self, path, depth, included_from, top=False):
        if depth > MAX_INCLUDE_DEPTH:
            raise FatalConfig(
                "include depth exceeded (cap is %d levels, KV02)"
                % MAX_INCLUDE_DEPTH, where=path)
        abspath = os.path.abspath(path)
        if abspath in self._stack:
            chain = " -> ".join(self._stack + [abspath])
            raise FatalConfig(
                "include cycle detected: %s (KV02)" % chain,
                where=path)
        try:
            lines, nbytes = logical_lines(path)
        except OSError as exc:
            raise _ReadError("cannot read config file %s: %s"
                             % (path, exc), where=path)
        self.files.append({"path": path, "bytes": nbytes,
                           "lines": len(lines),
                           "included_from": included_from})
        self._stack.append(abspath)
        # The include_check level is saved on entry and restored
        # on exit, so a level set inside an included file cannot
        # leak out (KV03). Top-level --conf files share one
        # stream, so they do not save/restore against each other.
        saved = None
        if not top:
            saved = set(self.check_level)
            self._level_stack.append(saved)
        try:
            base_dir = os.path.dirname(abspath)
            for lineno, text in lines:
                self._load_line(text, path, lineno, base_dir, depth)
        finally:
            self._stack.pop()
            if not top:
                self.check_level = self._level_stack.pop()

    def _load_line(self, text, path, lineno, base_dir, depth):
        where = "%s:%d" % (path, lineno)
        stripped = strip_comment(text)
        tokens = tokenize(stripped)
        if not tokens:
            return
        first = tokens[0].text
        # include_check lines are consumed in stream order: the
        # level governs the includes that follow in this file.
        if first == "include_check":
            self._apply_include_check(tokens, where)
            return
        if first.startswith("@") and len(tokens) >= 2 and \
                tokens[1].text == "include_check":
            gate, _rest = self._gate_of_at_line(tokens)
            if gate is None:
                self.findings.append(Finding(
                    "KV21", "finding",
                    "malformed @ conditional on include_check line "
                    "(KV05)", where))
                return
            if gate == GATED_UNKNOWN:
                self.findings.append(Finding(
                    "KV05", "finding",
                    "@-gated include_check line: the effective "
                    "include_check level for later includes is "
                    "[gated-unknown] without --config-id; level "
                    "left unchanged", where))
                return
            if gate == GATED_INCLUDED:
                self._apply_include_check(tokens[1:], where)
            return
        # @-prefixed include lines are not followed (KV04): the
        # include detector runs before conditional processing.
        if first.startswith("@") and len(tokens) >= 2 and \
                tokens[1].text in INCLUDE_VARIANTS:
            pattern = tokens[2].text if len(tokens) > 2 else ""
            self.unfollowed.append({
                "where": where, "pattern": pattern,
                "reason": "@-prefixed include line is not followed "
                          "(include detection runs before @ "
                          "conditional processing, KV04)"})
            self.findings.append(Finding(
                "KV04", "finding",
                "@-prefixed include %r is not followed; its "
                "contents are unknown to this tool (KV04)"
                % pattern, where))
            return
        if first in INCLUDE_VARIANTS:
            self._do_include(first, tokens[1:], base_dir, depth,
                             where)
            return
        self.lines.append(MergedLine(path, lineno, text))

    # -- includes ------------------------------------------------------

    def _do_include(self, variant, arg_tokens, base_dir, depth,
                    where):
        if not arg_tokens:
            self.findings.append(Finding(
                "KV21", "warning",
                "%s directive with no file argument" % variant,
                where))
            return
        pattern = arg_tokens[0].text
        if len(arg_tokens) > 1:
            self.findings.append(Finding(
                "KV21", "finding",
                "%s line has extra tokens after the filename "
                "(one filename per include line, KV02); using %r"
                % (variant, pattern), where))
        if "$" in pattern:
            # Include detection runs before parameter
            # substitution (KV04): the pattern is not followed
            # even when the parameter is defined.
            self.unfollowed.append({
                "where": where, "pattern": pattern,
                "reason": "include pattern contains $PARAM "
                          "reference; include detection runs before "
                          "substitution, so the pattern is not "
                          "followed (KV04)"})
            self.findings.append(Finding(
                "KV04", "finding",
                "include pattern %r contains a $PARAM reference "
                "and is not followed (KV04)" % pattern, where))
            return
        effective = set(self.check_level) | INCLUDE_VARIANTS[variant]
        self.expansions.append({
            "where": where, "variant": variant, "pattern": pattern,
            "level": sorted(effective), "matches": []})
        expansion = self.expansions[-1]
        if not os.path.isabs(pattern):
            self.findings.append(Finding(
                "KV02", "info",
                "relative include %r resolved against the "
                "including file's directory %s (the daemon's "
                "working directory is not the base, KV02)"
                % (pattern, base_dir), where))
        # brace_match: every first-level brace alternative must
        # match at least one file (KV03).
        if "brace_match" in effective and "{" in pattern:
            for alt in first_level_alternatives(pattern):
                if not self._expand_one(alt, base_dir):
                    raise FatalConfig(
                        "include %s: brace alternative %r matched "
                        "no file (brace_match, KV03)"
                        % (variant, alt), where=where)
        all_matches = []
        for expanded in expand_braces(pattern):
            matches = self._expand_one(expanded, base_dir)
            if glob.has_magic(expanded):
                if "wildcard_match" in effective and not matches:
                    raise FatalConfig(
                        "include %s: wildcard pattern %r matched "
                        "no files (wildcard_match, KV03)"
                        % (variant, expanded), where=where)
            else:
                if "match" in effective and not matches:
                    raise FatalConfig(
                        "include %s: %r matched no file "
                        "(match, KV03)" % (variant, expanded),
                        where=where)
            all_matches.extend(matches)
        # Deduplicate within one directive (overlapping brace
        # alternatives may match the same file); the daemon would
        # read it twice, which would manufacture duplicate
        # declarations, so one read per directive is the honest
        # reading [design rule].
        seen = set()
        matches = []
        for m in all_matches:
            if m not in seen:
                seen.add(m)
                matches.append(m)
        expansion["matches"] = matches
        if not matches:
            # Plain `include` silently tolerates a missing file
            # (KV03): a warning, and the verdict stands over the
            # files that did load.
            self.findings.append(Finding(
                "KV03", "warning",
                "%s %r matched no files; plain include tolerates "
                "this (warning only, KV03)" % (variant, pattern),
                where))
            return
        for match in matches:
            if not os.path.isabs(match):
                match = os.path.join(base_dir, match)
            try:
                self._load_one(match, depth + 1, where)
            except _ReadError as exc:
                if "readable" in effective:
                    raise FatalConfig(
                        "include %s: matched file %r is not "
                        "readable (readable check, KV03)"
                        % (variant, match), where=where)
                self.findings.append(Finding(
                    "KV03", "warning",
                    "include %s: matched file %r could not be "
                    "read (%s); plain include tolerates this "
                    "(KV03)" % (variant, match, exc.message),
                    where))

    def _expand_one(self, pattern, base_dir):
        """Glob one (brace-expanded) pattern against the including
        file's directory, returning matches in byte-wise sorted
        order (KV02: glob(3P) sorts by default; the C-locale
        reading is pinned and bannered in coverage)."""
        if not os.path.isabs(pattern):
            pattern = os.path.join(base_dir, pattern)
        if glob.has_magic(pattern):
            return sorted(glob.glob(pattern))
        return [pattern] if os.path.exists(pattern) else []

